{
  "name": "dsh-daughter",
  "version": "0.1.0",
  "description": "人格—记忆—状态—技能—反射 五维陪伴插件 / Persona, long-term memory, state, skills and reflexes for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "author": "han0han0le0ni",
  "homepage": "https://github.com/han0han0le0ni/dsh-daughter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/han0han0le0ni/dsh-daughter.git"
  },
  "bugs": {
    "url": "https://github.com/han0han0le0ni/dsh-daughter/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "memory",
    "companion",
    "desktop-pet"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./index.js",
    "./lib": "./dist/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./web/*": "./web/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "dist",
    "config.yaml",
    "web"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:link": "node --import tsx scripts/link-check.ts",
    "filter:sweep": "node --import tsx scripts/filter-sweep.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "immediately": false
    }
  }
}
